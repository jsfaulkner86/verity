# ─── Verity Configuration ───────────────────────────────────────────────────

# App
VERITY_ENV=development                   # development | staging | production
VERITY_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
VERITY_API_HOST=0.0.0.0
VERITY_API_PORT=8080

# LLM Adapter Keys (only set what you use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
GROK_API_KEY=xai-...

# Scoring Thresholds
VERITY_ACCEPT_THRESHOLD=0.80             # Overall score >= this → ACCEPT
VERITY_REFINE_THRESHOLD=0.55             # Between thresholds → REFINE
                                          # Below refine threshold → REJECT

# Risk Classifier
VERITY_HEALTHCARE_MODE=true              # Enables clinical claim detection
VERITY_PHI_DETECTION=true               # Flags potential PHI in responses

# Observability
LANGSMITH_API_KEY=ls__...               # Optional: LangSmith tracing
LANGSMITH_PROJECT=verity
OTEL_EXPORTER_OTLP_ENDPOINT=           # Optional: OpenTelemetry endpoint

# Audit Log
VERITY_AUDIT_LOG_PATH=./logs/audit.jsonl
VERITY_AUDIT_RETENTION_DAYS=90
